DATABASE_URL="postgresql://pooln:pooln@localhost:5432/pooln"
PORT=3000
JWT_ACCESS_SECRET="change-me-in-local-env"
JWT_REFRESH_SECRET="change-me-too-in-local-env"

# DynamoDB Local (docker-compose) doesn't validate credentials — any
# non-empty values work here. No AWS account needed for local dev/test.
AWS_REGION="local"
AWS_ACCESS_KEY_ID="local"
AWS_SECRET_ACCESS_KEY="local"
DYNAMODB_TABLE_NAME="poolnDB"
DYNAMODB_ENDPOINT="http://localhost:8000"
