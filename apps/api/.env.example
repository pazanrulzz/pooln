PORT=3000
JWT_ACCESS_SECRET="change-me-in-local-env"
JWT_REFRESH_SECRET="change-me-too-in-local-env"

# `pnpm dev` talks directly to the real DynamoDB table in AWS — these need
# to be real credentials for an account that can read/write it (DYNAMODB_ENDPOINT
# below stays unset so the SDK uses the real regional endpoint).
AWS_REGION="your-table-region"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
DYNAMODB_TABLE_NAME="poolnDB"

# `pnpm test` always runs against DynamoDB Local (docker compose up) on its
# own, regardless of this file — it never touches the real table. If you'd
# rather run `pnpm dev` against DynamoDB Local too (no AWS account needed),
# uncomment this, run `docker compose up` and `tsx scripts/ensure-table.ts`
# first, and any non-empty values above work.
# DYNAMODB_ENDPOINT="http://localhost:8000"
