generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  displayName     String   @map("display_name")
  avatarUrl       String?  @map("avatar_url")
  defaultCurrency String   @default("USD") @map("default_currency") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]
  expensesCreated       Expense[]            @relation("ExpensesCreated")
  expenseParticipations ExpenseParticipant[] @relation("ExpenseParticipations")
  settlementsSent       Settlement[]         @relation("SettlementsSent")
  settlementsReceived   Settlement[]         @relation("SettlementsReceived")
  settlementsRecorded   Settlement[]         @relation("SettlementsRecorded")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

model Expense {
  id               String    @id @default(uuid())
  description      String
  amountMinorUnits Int       @map("amount_minor_units")
  currency         String    @db.Char(3)
  splitType        SplitType @map("split_type")
  date             DateTime  @default(now())
  notes            String?
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  createdBy    User                 @relation("ExpensesCreated", fields: [createdById], references: [id])
  participants ExpenseParticipant[]

  @@index([createdById])
  @@map("expenses")
}

model ExpenseParticipant {
  id                   String @id @default(uuid())
  expenseId            String @map("expense_id")
  userId               String @map("user_id")
  paidAmountMinorUnits Int    @default(0) @map("paid_amount_minor_units")
  owedAmountMinorUnits Int    @default(0) @map("owed_amount_minor_units")
  sharePercentBp       Int?   @map("share_percent_bp")
  shareUnits           Int?   @map("share_units")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation("ExpenseParticipations", fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

model Settlement {
  id               String    @id @default(uuid())
  fromUserId       String    @map("from_user_id")
  toUserId         String    @map("to_user_id")
  amountMinorUnits Int       @map("amount_minor_units")
  currency         String    @db.Char(3)
  note             String?
  settledAt        DateTime  @default(now()) @map("settled_at")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  fromUser  User @relation("SettlementsSent", fields: [fromUserId], references: [id])
  toUser    User @relation("SettlementsReceived", fields: [toUserId], references: [id])
  createdBy User @relation("SettlementsRecorded", fields: [createdById], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}

// Groups and other domain models land in later phases.
