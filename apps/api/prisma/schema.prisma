generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and RefreshToken moved to DynamoDB in the Phase 1 auth cutover (see
// the plan file) — Expense/ExpenseParticipant/Settlement still reference
// user ids as plain strings (no FK, no Prisma relation: Postgres no longer
// has any record of users at all, so a foreign key constraint against a
// `users` table would reject every insert). These three models move to
// DynamoDB too in a later phase; this whole file goes away after that.

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

model Expense {
  id               String    @id @default(uuid())
  description      String
  amountMinorUnits Int       @map("amount_minor_units")
  currency         String    @db.Char(3)
  splitType        SplitType @map("split_type")
  date             DateTime  @default(now())
  notes            String?
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  participants ExpenseParticipant[]

  @@index([createdById])
  @@map("expenses")
}

model ExpenseParticipant {
  id                   String @id @default(uuid())
  expenseId            String @map("expense_id")
  userId               String @map("user_id")
  paidAmountMinorUnits Int    @default(0) @map("paid_amount_minor_units")
  owedAmountMinorUnits Int    @default(0) @map("owed_amount_minor_units")
  sharePercentBp       Int?   @map("share_percent_bp")
  shareUnits           Int?   @map("share_units")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

model Settlement {
  id               String    @id @default(uuid())
  fromUserId       String    @map("from_user_id")
  toUserId         String    @map("to_user_id")
  amountMinorUnits Int       @map("amount_minor_units")
  currency         String    @db.Char(3)
  note             String?
  settledAt        DateTime  @default(now()) @map("settled_at")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}

// Groups and other domain models land in later phases.
